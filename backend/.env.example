# Environment Configuration for Backend
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# SQLite Zero-Daemon Local Database
SQLITE_DB_PATH=./var/prediction_intelligence.db
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./var/screenshots
ANALYSIS_TASK_MODE=inline

# Vision & Multimodal AI (Gemini API)
VISION_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
# Get your Google Gemini API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Platform Adapters
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com
BAYSE_API_URL=https://relay.bayse.markets

# Decision & Risk Parameters
DECISION_MIN_EDGE=0.04
DECISION_MAX_SPREAD=0.05
FEED_STALENESS_THRESHOLD_SECONDS=3.0
