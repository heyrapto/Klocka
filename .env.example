# ==============================================================================
# Prediction Intelligence Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit real credentials or private keys to source control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# SQLite Zero-Daemon Local Database
SQLITE_DB_PATH=./var/prediction_intelligence.db
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./var/screenshots
ANALYSIS_TASK_MODE=inline

# Redis & Celery Background Queues
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI / Vision Models & LLM Gateway
VISION_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
VISION_MODEL_ID=gpt-4o-mini
LLM_PROVIDER=gemini
OPENAI_API_KEY=your-openai-api-key-if-used
ANTHROPIC_API_KEY=your-anthropic-api-key-if-used

# External Market Data & Platform Adapters
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com
BAYSE_API_URL=https://api.bayse.markets/v1
BAYSE_API_KEY=your-bayse-api-key-if-required
BINANCE_API_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
COINBASE_API_URL=https://api.exchange.coinbase.com
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com

# Market Data Transport (DNS resilience, timeouts, concurrency budget)
# The system resolver is always tried first. DNS-over-HTTPS is used only when it
# fails or times out. Use IP-literal DoH endpoints so the fallback can bootstrap
# even when the system resolver is the broken component.
MARKET_DATA_DNS_FALLBACK_ENABLED=true
MARKET_DATA_DOH_ENDPOINTS=https://1.1.1.1/dns-query,https://8.8.8.8/resolve
MARKET_DATA_DNS_SYSTEM_TIMEOUT_SECONDS=0.8
MARKET_DATA_DNS_DOH_TIMEOUT_SECONDS=2.5
MARKET_DATA_DNS_CACHE_TTL_SECONDS=300
MARKET_DATA_DNS_NEGATIVE_CACHE_SECONDS=30
MARKET_DATA_CONNECT_TIMEOUT_SECONDS=4.0
MARKET_DATA_READ_TIMEOUT_SECONDS=8.0
MARKET_DATA_GROUP_BUDGET_SECONDS=10.0
# When HTTPS_PROXY/ALL_PROXY is set, the proxy owns resolution and the DoH
# fallback is disabled automatically.

# Forecasting & Risk Decision Gates
# Blend weights must each group sum to exactly 1.0; the app refuses to start otherwise.
FORECAST_CRYPTO_MATH_WEIGHT=0.40
FORECAST_CRYPTO_LLM_WEIGHT=0.10
FORECAST_CRYPTO_MARKET_WEIGHT=0.50
FORECAST_GENERAL_LLM_WEIGHT=0.35
FORECAST_GENERAL_MARKET_WEIGHT=0.65
# Block crypto trades when oracle, strike, or comparator semantics are unresolved.
CONTRACT_SPEC_STRICT_CRYPTO=true
DECISION_MIN_EDGE=0.04
DECISION_MAX_SPREAD=0.05
DECISION_MIN_DEPTH_USD=100
DECISION_TARGET_ORDER_USD=100
DECISION_UNCERTAINTY_MARGIN=0.02
DECISION_SLIPPAGE_BPS=15
DECISION_KELLY_FRACTION=0.25
DECISION_MAX_QUOTE_AGE_SECONDS=15
DECISION_POLICY_VERSION=decision_policy_v1
FEED_STALENESS_THRESHOLD_SECONDS=3.0
ANALYSIS_TIMEOUT_SECONDS=180
